# ===== social-publisher — variáveis de ambiente =====
# Copie este arquivo para ".env" e preencha. NUNCA faça commit do .env.

# --- Chrome (render) ---
# Caminho do executável do Chrome. Windows padrão:
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Instagram Graph API ---
# Versão da Graph API (confirmar a mais recente ao construir/testar):
GRAPH_VERSION=v21.0
# ID da conta Instagram Business (ig-user-id). Ex.: 178414... (número).
IG_USER_ID=
# Token de acesso. Preferir System User token (não expira) da BM da marca.
IG_ACCESS_TOKEN=

# --- Hospedagem das imagens: "github" (etapa 1, sem cartão) ou "r2" (etapa 2, produção) ---
IMAGE_HOST=github

# --- GitHub (ETAPA 1) — repo PÚBLICO onde os JPGs ficam ---
# Formato "usuario/repositorio". O repo precisa ser público.
GITHUB_REPO=
GITHUB_BRANCH=main
# Token com permissão de escrever conteúdo NESSE repo (Contents: Read and write).
GITHUB_TOKEN=

# --- Cloudflare R2 (ETAPA 2, produção) ---
# Endpoint S3 do R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=resvy-social
# Base pública do bucket (domínio r2.dev habilitado, ou domínio custom).
# Ex.: https://pub-xxxxxxxx.r2.dev  (SEM barra no final)
R2_PUBLIC_BASE=
